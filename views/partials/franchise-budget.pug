table.data-table.budget-table.w-100.mb-0
	thead
		tr
			th
			th.data-table__num= currentSeason
			th.data-table__num= currentSeason + 1
			th.data-table__num= currentSeason + 2
	tbody
		tr
			td Base
			td.data-table__num #{formatMoney(b[0].baseAmount)}
			td.data-table__num #{formatMoney(b[1].baseAmount)}
			td.data-table__num #{formatMoney(b[2].baseAmount)}
		tr.budget-table__payroll
			td Payroll
			td.data-table__num #{formatMoney(b[0].payroll, { sign: '-' })}
			td.data-table__num #{formatMoney(b[1].payroll, { sign: '-' })}
			td.data-table__num #{formatMoney(b[2].payroll, { sign: '-' })}
		tr
			td Buyouts
			td.data-table__num #{formatMoney(b[0].buyOuts, { sign: '-' })}
			td.data-table__num #{formatMoney(b[1].buyOuts, { sign: '-' })}
			td.data-table__num #{formatMoney(b[2].buyOuts, { sign: '-' })}
		tr
			td Cash In
			td.data-table__num #{formatMoney(b[0].cashIn, { sign: '+' })}
			td.data-table__num #{formatMoney(b[1].cashIn, { sign: '+' })}
			td.data-table__num #{formatMoney(b[2].cashIn, { sign: '+' })}
		tr
			td Cash Out
			td.data-table__num #{formatMoney(b[0].cashOut, { sign: '-' })}
			td.data-table__num #{formatMoney(b[1].cashOut, { sign: '-' })}
			td.data-table__num #{formatMoney(b[2].cashOut, { sign: '-' })}
		tr.budget-table__available
			td: strong Available
			td.data-table__num: strong #{formatMoney(b[0].available)}
			td.data-table__num: strong #{formatMoney(b[1].available)}
			td.data-table__num: strong #{formatMoney(b[2].available)}
		tr.budget-table__recoverable
			td Recoverable
			td.data-table__num #{formatMoney(b[0].recoverable, { sign: '+' })}
			td.data-table__num #{formatMoney(b[1].recoverable, { sign: '+' })}
			td.data-table__num #{formatMoney(b[2].recoverable, { sign: '+' })}
		tr.budget-table__effective
			td Effective Cap
			td.data-table__num #{formatMoney(b[0].baseAmount - b[0].buyOuts - b[0].cashOut + b[0].cashIn)}
			td.data-table__num #{formatMoney(b[1].baseAmount - b[1].buyOuts - b[1].cashOut + b[1].cashIn)}
			td.data-table__num #{formatMoney(b[2].baseAmount - b[2].buyOuts - b[2].cashOut + b[2].cashIn)}
if pendingContractCount > 0
	div.budget-table__pending-note
		i.fa.fa-info-circle.mr-1
		| Reflects #{pendingContractCount} pending contract #{pendingContractCount === 1 ? 'assignment' : 'assignments'}
