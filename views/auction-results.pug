extends layout.pug
include mixins

block title
	+title(season + ' Auction Results')

block styles
	link(rel='stylesheet' href='/css/positions.css')

block content
	div.container.py-4
		div.page-header
			h1 #{season} Auction Results

		if results.length === 0
			p.text-muted No auction results recorded yet.

		else
			div.row
				div.col-lg-10.col-xl-8
					table.data-table
						thead
							tr
								th Player
								th.text-center Pos
								th NFL
								th Winner
								th.data-table__num Bid
								th Type
						tbody
							each result in results
								tr
									td
										if result.playerSlug
											a(href='/players/' + result.playerSlug)= result.playerName
										else
											| #{result.playerName}
									td.text-center
										if result.positions && result.positions.length > 0
											+positionBadge(result.positions)
									td
										if result.team
											| #{result.team}
									td
										if result.winnerRosterId
											a(href='/franchises/' + result.winnerRosterId)= result.winner
										else
											| #{result.winner}
									td.data-table__num #{formatMoney(result.winningBid)}
									td
										if result.type === 'auction-rfa-unmatched' && result.rfaHolder
											span.text-muted RFA not matched (#{result.rfaHolder})
										else
											span.text-muted= result.typeDisplay
