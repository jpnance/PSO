extends layout.pug
include mixins

block title
	+title(season + ' Auction Results')

block og_meta
	meta(property='og:title' content=season + ' Auction Results')
	meta(property='og:description' content='Free agent auction results for the ' + season + ' season')
	meta(property='og:image' content='https://thedynastyleague.com/images/og/gavel.jpg')
	meta(property='og:url' content='https://thedynastyleague.com/auction/results/' + season)

block styles
	link(rel='stylesheet' href='/css/positions.css')
	link(rel='stylesheet' href='/css/auction-results.css')

block content
	div.container.py-4
		div.page-header
			h1 #{season} Auction Results

		if allSeasons && allSeasons.length > 1
			div.page-nav.mb-4
				+sequentialNav({ items: allSeasons, current: season, urlPattern: '/auction/results/' })

		if results.length === 0
			p.text-muted No auction results recorded yet.

		else
			div.row
				div.col-md-8.col-lg-6
					div.card
						div.auction-results__toolbar
							div.auction-results__sorts
								if isHistorical
									button.btn.btn-sm.btn-outline-secondary(type='button' disabled data-toggle='tooltip' title='Chronological order was not recorded for this auction')
										i.fa.fa-clock-o
								else
									button.btn.btn-sm.btn-primary(type='button' data-sort='time')
										i.fa.fa-clock-o
								button.btn.btn-sm(type='button' data-sort='name' class=(isHistorical ? 'btn-primary' : 'btn-outline-secondary'))
									i.fa.fa-sort-alpha-asc
								button.btn.btn-sm.btn-outline-secondary(type='button' data-sort='salary')
									i.fa.fa-dollar
						div.auction-results__list
							each result in results
								- var posGroup = result.positions && result.positions.length > 0 ? (result.positions.includes('DL') || result.positions.includes('LB') || result.positions.includes('DB') ? 'IDP' : result.positions[0]) : null
								div.auction-results__row(data-name=result.playerName data-salary=result.winningBid data-time=result.timestamp.getTime() class=(posGroup ? 'pos-' + posGroup : ''))
									div.auction-results__details
										div.auction-results__player
											if result.playerSlug
												a.auction-results__player-name(href='/players/' + result.playerSlug)= result.playerName
											else
												span.auction-results__player-name= result.playerName
										div.auction-results__meta
											span.auction-results__bid= formatMoney(result.winningBid)
											|  · 
											if result.winnerRosterId
												a(href='/franchises/' + result.winnerRosterId)= result.winner
											else
												| #{result.winner}
									div.auction-results__badge
										if result.positions && result.positions.length > 0
											+positionBadge(result.positions)
										if result.type === 'auction-rfa-unmatched' && result.rfaHolder
											div.auction-results__type RFA not matched (#{result.rfaHolder})
										else if result.type === 'auction-rfa-matched'
											div.auction-results__type RFA matched
										else
											div.auction-results__type UFA

block scripts
	script(src='/js/auction-results.js')
	if isHistorical
		script.
			$(function() { $('[data-toggle="tooltip"]').tooltip(); });
