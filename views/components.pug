			div.d-flex.flex-wrap(style="gap: 1rem;")
				div(style="width: 280px; border: 1px dashed #ccc; padding: 0.5rem;")
					small.text-muted 280px (no PF/PA)
					+standingsTable(sampleTeams.slice(0, 3), { variant: 'widget' })
				div(style="width: 340px; border: 1px dashed #ccc; padding: 0.5rem;")
					small.text-muted 340px (no PA)
					+standingsTable(sampleTeams.slice(0, 3), { variant: 'widget' })
				div(style="width: 420px; border: 1px dashed #ccc; padding: 0.5rem;")
					small.text-muted 420px (all columns)
					+standingsTable(sampleTeams.slice(0, 3), { variant: 'widget' })

		//- Sequential Nav
		div.component-section
			h2 +sequentialNav(options)
			code.usage +sequentialNav({ items, current, urlPattern, quickItems?, jumpLabel?, labelFn? })
			
			div.preview-row.mt-4
				span.variant-label Simple Mode
			p.small.text-muted.mb-2 With prev/next only: arrows with current label in center.
			+sequentialNav({ prev: 42, next: 44, current: 'Trade #43', urlPattern: '#' })
			
			div.preview-row.mt-4
				span.variant-label Dropdown Mode
			p.small.text-muted.mb-2 Without quickItems: dropdown in center between arrows.
			+sequentialNav({ items: [2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025], current: 2024, urlPattern: '#' })
			
			div.preview-row.mt-4
				span.variant-label Pills Mode
			p.small.text-muted.mb-2 With quickItems: pills in center, optional jump dropdown on left.
