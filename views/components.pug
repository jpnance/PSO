extends layout

include mixins

block title
	+title('Component Library')

block styles
	link(rel='stylesheet' href='/css/positions.css')
	style.
		.component-section {
			margin-bottom: 2rem;
			padding: 1.5rem;
			border: 1px solid #dee2e6;
			border-radius: 8px;
			background: #fff;
		}
		.component-section h2 {
			font-size: 1rem;
			margin-bottom: 0.25rem;
		}
		.component-section .usage {
			font-family: monospace;
			font-size: 0.75rem;
			color: #6c757d;
			margin-bottom: 1rem;
			background: #f8f9fa;
			padding: 0.4rem 0.6rem;
			border-radius: 4px;
			display: inline-block;
		}
		.preview-row {
			display: flex;
			align-items: center;
			gap: 1rem;
			flex-wrap: wrap;
			margin-bottom: 1rem;
		}
		.variant-label {
			font-size: 0.7rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: #6c757d;
			flex-shrink: 0;
			font-weight: 600;
		}
		.trade-card-preview {
			border: 1px solid #dee2e6;
			border-radius: 8px;
			padding: 1rem;
		}
		.nav-container {
			background: #f8f9fa;
			padding: 1rem;
			border-radius: 8px;
		}
		.color-swatch {
			display: inline-block;
			width: 40px;
			height: 24px;
			border-radius: 4px;
			border: 1px solid rgba(0,0,0,0.1);
		}
		.color-circle {
			display: inline-block;
			width: 24px;
			height: 24px;
			border-radius: 50%;
		}

block scripts
	script.
		(function() {
			var schemes = [
				{ name: 'Sage', bg: '#f0f4f0', text: '#3d5240', border: '#dde5dd', link: '#4a7050', linkHover: '#3d5240' },
				{ name: 'White', bg: '#ffffff', text: '#495057', border: '#dee2e6', link: null, linkHover: null },
				{ name: 'Near White', bg: '#fafbfc', text: '#495057', border: '#e9ecef', link: null, linkHover: null },
				{ name: 'Cool Gray', bg: '#f3f4f6', text: '#4b5563', border: '#e5e7eb', link: '#5a6272', linkHover: '#4b5563' },
				{ name: 'Warm Gray', bg: '#f5f5f4', text: '#57534e', border: '#e7e5e4', link: '#6b6660', linkHover: '#57534e' },
				{ name: 'Slate', bg: '#e8eaed', text: '#3d4450', border: '#d0d4da', link: '#4d5565', linkHover: '#3d4450' },
				{ name: 'Mist', bg: '#f2f5f7', text: '#465660', border: '#dfe4e8', link: '#566672', linkHover: '#465660' },
				{ name: 'Steel Blue', bg: '#e4ecf5', text: '#2c4a6e', border: '#c8d6e8', link: '#3a5a80', linkHover: '#2c4a6e' },
				{ name: 'Deep Navy', bg: '#d9e2ef', text: '#1e3252', border: '#bcc9dc', link: '#2e4265', linkHover: '#1e3252' },
				{ name: 'Midnight', bg: '#2c3e50', text: '#ecf0f1', border: '#1a252f', link: '#b0c4d8', linkHover: '#ecf0f1' },
				{ name: 'Ice', bg: '#edf4f7', text: '#2e5465', border: '#d4e4eb', link: '#3e6878', linkHover: '#2e5465' },
				{ name: 'Teal', bg: '#e0f0ef', text: '#1a5c56', border: '#b8d8d5', link: '#2a7068', linkHover: '#1a5c56' },
				{ name: 'Forest', bg: '#dce8dc', text: '#2d5030', border: '#bad0ba', link: '#3d6340', linkHover: '#2d5030' },
				{ name: 'Sand (active)', bg: '#f7f3eb', text: '#5c5040', border: '#e8e0d0', link: '#7a6e55', linkHover: '#5c5040' },
				{ name: 'Parchment', bg: '#f0e8d8', text: '#5a4e35', border: '#ddd0b8', link: '#756545', linkHover: '#5a4e35' },
				{ name: 'Khaki', bg: '#e8e0c8', text: '#4a4530', border: '#d0c8a8', link: '#605840', linkHover: '#4a4530' },
				{ name: 'Lavender', bg: '#ece4f5', text: '#3e2d5c', border: '#d5c8e8', link: '#5a4578', linkHover: '#3e2d5c' },
				{ name: 'Plum', bg: '#e0d0e8', text: '#42284f', border: '#c8b0d5', link: '#583868', linkHover: '#42284f' },
				{ name: 'Rose', bg: '#f5e8ec', text: '#5c2d3d', border: '#e8ced6', link: '#784050', linkHover: '#5c2d3d' },
				{ name: 'Coral', bg: '#f5e0da', text: '#6b3028', border: '#e8c4bb', link: '#884038', linkHover: '#6b3028' },
				{ name: 'Amber', bg: '#f5ecd5', text: '#5c4a1e', border: '#e8d8b0', link: '#756030', linkHover: '#5c4a1e' },
			];
			var idx = 0;
			function apply(i) {
				idx = i;
				var s = schemes[i];
				document.documentElement.style.setProperty('--card-header-bg', s.bg);
				document.documentElement.style.setProperty('--card-header-text', s.text);
				document.documentElement.style.setProperty('--card-header-border', s.border);
				if (s.link) {
					document.documentElement.style.setProperty('--card-footer-link', s.link);
					document.documentElement.style.setProperty('--card-footer-link-hover', s.linkHover);
				} else {
					document.documentElement.style.removeProperty('--card-footer-link');
					document.documentElement.style.removeProperty('--card-footer-link-hover');
				}
				document.getElementById('scheme-name').textContent = s.name;
				document.getElementById('scheme-counter').textContent = (i + 1) + ' / ' + schemes.length;
				document.getElementById('scheme-values').textContent = 'bg: ' + s.bg + ' \u00b7 text: ' + s.text + ' \u00b7 border: ' + s.border;
				var btns = document.querySelectorAll('.scheme-dot');
				btns.forEach(function(b, j) {
					b.classList.toggle('scheme-dot--active', j === i);
				});
			}
			document.addEventListener('DOMContentLoaded', function() {
				var dots = document.getElementById('scheme-dots');
				schemes.forEach(function(s, i) {
					var btn = document.createElement('button');
					btn.className = 'scheme-dot' + (i === 0 ? ' scheme-dot--active' : '');
					btn.style.background = s.bg;
					btn.style.borderColor = s.border;
					btn.title = s.name;
					btn.onclick = function() { apply(i); };
					dots.appendChild(btn);
				});
				document.getElementById('scheme-prev').onclick = function() {
					apply((idx - 1 + schemes.length) % schemes.length);
				};
				document.getElementById('scheme-next').onclick = function() {
					apply((idx + 1) % schemes.length);
				};
			});
		})();

block content
	div.container.py-4
		h1 Component Library
		p.text-muted.mb-4 A visual reference for shared Pug mixins and design tokens

		//- Card Header Color Picker
		div.component-section
			h2 Card Header Color Scheme
			p.usage Click dots or arrows to cycle through header color options. Changes apply to all cards on this page.
			style.
				.scheme-picker {
					display: flex;
					align-items: center;
					gap: 0.75rem;
					margin-bottom: 1rem;
				}
				.scheme-picker__arrows {
					display: flex;
					gap: 0.25rem;
				}
				.scheme-picker__btn {
					background: none;
					border: 1px solid #dee2e6;
					border-radius: 4px;
					padding: 0.25rem 0.6rem;
					cursor: pointer;
					font-size: 1rem;
					width: 2.2rem;
					text-align: center;
				}
				.scheme-picker__btn:hover {
					background: #f0f0f0;
				}
				.scheme-picker__name {
					font-weight: 600;
					font-size: 1rem;
				}
				.scheme-picker__counter {
					font-size: 0.75rem;
					color: var(--text-muted);
					margin-left: 0.5rem;
				}
				.scheme-dots {
					display: flex;
					flex-wrap: wrap;
					gap: 0.4rem;
					margin-bottom: 0.75rem;
				}
				.scheme-dot {
					width: 28px;
					height: 28px;
					border-radius: 50%;
					border: 2px solid #ccc;
					cursor: pointer;
					padding: 0;
					transition: transform 0.1s;
				}
				.scheme-dot:hover {
					transform: scale(1.15);
				}
				.scheme-dot--active {
					border-color: #333;
					box-shadow: 0 0 0 2px rgba(0,0,0,0.2);
				}
				.scheme-values {
					font-family: monospace;
					font-size: 0.75rem;
					color: var(--text-muted);
					margin-bottom: 1rem;
				}
			div.scheme-picker
				div.scheme-picker__arrows
					button.scheme-picker__btn#scheme-prev ←
					button.scheme-picker__btn#scheme-next →
				span.scheme-picker__name#scheme-name Sage (current)
				span.scheme-picker__counter#scheme-counter 1 / 21
			div.scheme-dots#scheme-dots
			div.scheme-values#scheme-values bg: #f0f4f0 · text: #3d5240 · border: #dde5dd
			div.row
				div.col-md-4
					div.card
						div.card-header Calendar
						div.card-body
							p.text-muted.mb-0 Sample card content
						a.card-footer-link(href='#')
							span View Full Calendar
							i.fa.fa-chevron-right
				div.col-md-4
					div.card
						div.card-header Recent Transactions
						div.card-body
							p.text-muted.mb-0 Sample card content
						a.card-footer-link(href='#')
							span View Trade History
							i.fa.fa-chevron-right
				div.col-md-4
					div.card
						div.card-header Available Cash
						div.card-body
							p.text-muted.mb-0 Sample card content

		//- Position Badge
		div.component-section
			h2 +positionBadge(positions)
			code.usage +positionBadge(['QB']) | +positionBadge(['RB', 'WR'])
			div.preview-row
				span.variant-label Single
				+positionBadge(['QB'])
				+positionBadge(['RB'])
				+positionBadge(['WR'])
				+positionBadge(['TE'])
				+positionBadge(['DL'])
				+positionBadge(['LB'])
				+positionBadge(['DB'])
				+positionBadge(['K'])
			div.preview-row
				span.variant-label Multi
				+positionBadge(['RB', 'WR'])
				+positionBadge(['DL', 'LB'])

		//- Status Badge
		div.component-section
			h2 +statusBadge(status, displayText?)
			code.usage +statusBadge('pending') | +statusBadge('hypothetical')
			div.preview-row
				+statusBadge('hypothetical')
				+statusBadge('pending')
				+statusBadge('accepted')
				+statusBadge('rejected')
			div.preview-row
				+statusBadge('canceled')
				+statusBadge('expired')
				+statusBadge('executed')

		//- Season Tile
		div.component-section
			h2 +seasonTile(result, options?)
			code.usage +seasonTile({ season: 2024, wins: 10, losses: 5, playoffFinish: 'champion' }, { href: '/schedule/2024' })
			div.preview-row
				span.variant-label Playoff Finish
			div.d-flex.align-items-center(style="gap: 0.5rem;")
				+seasonTile({ season: 2024, wins: 13, losses: 2, playoffFinish: 'champion' })
				span.small Champion
				+seasonTile({ season: 2023, wins: 11, losses: 4, playoffFinish: 'runner-up' })
				span.small Runner-up
				+seasonTile({ season: 2022, wins: 10, losses: 5, playoffFinish: 'third-place' })
				span.small Third
				+seasonTile({ season: 2021, wins: 9, losses: 6, madePlayoffs: true })
				span.small Playoffs
				+seasonTile({ season: 2020, wins: 5, losses: 10 })
				span.small Regular
			
			div.preview-row.mt-3
				span.variant-label Custom Color
			p.small.text-muted.mb-2 Override background with any color (bypasses playoff styling).
			div.d-flex.align-items-center(style="gap: 0.5rem;")
				+seasonTile({ season: 2024 }, { color: '#4a90d9' })
				+seasonTile({ season: 2023 }, { color: '#e74c3c' })
				+seasonTile({ season: 2022 }, { color: '#2ecc71' })
				+seasonTile({ season: 2021 }, { color: '#9b59b6' })
			
			div.preview-row.mt-3
				span.variant-label Size Variants
			div.d-flex.align-items-center(style="gap: 0.5rem;")
				+seasonTile({ season: 2024, wins: 10, losses: 5, playoffFinish: 'champion' }, { size: 'sm' })
				span.small Small (10px)
				+seasonTile({ season: 2024, wins: 10, losses: 5, playoffFinish: 'champion' })
				span.small Default (14px)
				+seasonTile({ season: 2024, wins: 10, losses: 5, playoffFinish: 'champion' }, { size: 'lg' })
				span.small Large (18px)
			
			div.preview-row.mt-3
				span.variant-label As Links
			p.small.text-muted.mb-2 With href option, tiles become clickable links.
			div.d-flex.align-items-center(style="gap: 0.25rem;")
				+seasonTile({ season: 2020, wins: 8, losses: 7 }, { href: '#', color: '#4a90d9' })
				+seasonTile({ season: 2021, wins: 10, losses: 5, madePlayoffs: true }, { href: '#', color: '#4a90d9' })
				+seasonTile({ season: 2022, wins: 12, losses: 3, playoffFinish: 'runner-up' }, { href: '#', color: '#4a90d9' })
				+seasonTile({ season: 2023, wins: 11, losses: 4, madePlayoffs: true }, { href: '#', color: '#4a90d9' })
				+seasonTile({ season: 2024, wins: 13, losses: 2, playoffFinish: 'champion' }, { href: '#', color: '#4a90d9' })

		//- Matchup
		div.component-section
			h2 +matchup(game, options?)
			code.usage +matchup({ away: { name, score, record, seed, won }, home: {...}, type }, { label: 'Semifinal' })
			div.preview-row
				span.variant-label Upcoming
			div(style="max-width: 300px;")
				+matchup({ away: { name: 'Syed/Terence', record: '8-3' }, home: { name: 'Mitch/Karsten', record: '7-4' } })
			
			div.preview-row.mt-3
				span.variant-label Final
			div(style="max-width: 300px;")
				+matchup({ away: { name: 'Koci/Mueller', score: 142.56, record: '9-3', won: true }, home: { name: 'Schex', score: 128.34, record: '7-5', won: false } })
			
			div.preview-row.mt-3
				span.variant-label Playoffs
			div(style="max-width: 350px;")
				+matchup({ away: { name: 'Syed/Terence', score: 156.78, seed: 2, won: true }, home: { name: 'Nance', score: 142.12, seed: 3 }, type: 'semifinal' }, { label: 'Semifinal 1' })
				+matchup({ away: { name: 'Keyon', score: 148.90, seed: 1, won: true }, home: { name: 'Mitch/Karsten', score: 134.56, seed: 4 }, type: 'semifinal' }, { label: 'Semifinal 2' })
			
			div.preview-row.mt-3
				span.variant-label Championship
			div(style="max-width: 350px;")
				+matchup({ away: { name: 'Syed/Terence', score: 167.23, seed: 2, won: true }, home: { name: 'Keyon', score: 154.89, seed: 1 }, type: 'championship' }, { label: 'Championship' })
				+matchup({ away: { name: 'Nance', score: 138.45, seed: 3, won: true }, home: { name: 'Mitch/Karsten', score: 125.67, seed: 4 }, type: 'thirdPlace' }, { label: 'Third Place' })
			
			div.preview-row.mt-3
				span.variant-label With Subtitle
			p.small.text-muted.mb-2 Optional subtitle for regime names. Subtitle appears under the name, not the seed.
			div(style="max-width: 450px;")
				+matchup({ away: { name: 'Franchise 9', subtitle: 'Koci/Mueller', score: 156.78, seed: 2, won: true }, home: { name: 'Franchise 1', subtitle: 'Patrick & Mike', score: 142.12, seed: 3 }, type: 'championship' }, { label: 'Championship' })
			
			div.preview-row.mt-4
				span.variant-label Container
			p.small.text-muted.mb-2 Container queries: records hidden &lt;230px, shown at 230px+. Subtitles always visible.
			div.d-flex.flex-wrap(style="gap: 1rem;")
				div(style="width: 220px; border: 1px dashed #ccc; padding: 0.5rem;")
					small.text-muted 220px (no record)
					+matchup({ away: { name: 'Syed/Terence', score: 142.56, record: '9-3', won: true }, home: { name: 'Koci/Mueller', score: 128.34, record: '7-5' } })
				div(style="width: 320px; border: 1px dashed #ccc; padding: 0.5rem;")
					small.text-muted 320px (with record)
					+matchup({ away: { name: 'Syed/Terence', score: 142.56, record: '9-3', won: true }, home: { name: 'Koci/Mueller', score: 128.34, record: '7-5' } })
			
			div.preview-row.mt-4
				span.variant-label Subtitle Sizes
			p.small.text-muted.mb-2 Regular season game with franchise name + regime subtitle at various widths.
			div.d-flex.flex-wrap(style="gap: 1rem;")
				div(style="width: 220px; border: 1px dashed #ccc; padding: 0.5rem;")
					small.text-muted 220px (no record)
					+matchup({ away: { name: 'Franchise 9', subtitle: 'Syed/Terence', score: 142.56, record: '9-3', won: true }, home: { name: 'Franchise 1', subtitle: 'Mitch/Karsten', score: 128.34, record: '7-5' } })
				div(style="width: 320px; border: 1px dashed #ccc; padding: 0.5rem;")
					small.text-muted 320px (with record)
					+matchup({ away: { name: 'Franchise 9', subtitle: 'Syed/Terence', score: 142.56, record: '9-3', won: true }, home: { name: 'Franchise 1', subtitle: 'Mitch/Karsten', score: 128.34, record: '7-5' } })

		//- Standings Table
		div.component-section
			h2 +standingsTable(teams, options?)
			code.usage +standingsTable(teams, { variant: 'widget', showMedals: true, showCutoff: true })
			-
				var sampleTeams = [
					{ rank: 1, name: 'Keyon', wins: 13, losses: 2, pointsFor: 2156.45, pointsAgainst: 1823.12, allPlay: { wins: 142, losses: 23, ties: 0 }, stern: { wins: 28, losses: 2, ties: 0 }, isPlayoffTeam: true, playoffSeed: 1, playoffWins: 2, playoffLosses: 0, playoffPointsFor: 312.45, playoffPointsAgainst: 278.90 },
					{ rank: 2, name: 'Koci/Mueller', wins: 12, losses: 3, pointsFor: 2089.23, pointsAgainst: 1756.78, allPlay: { wins: 138, losses: 27, ties: 0 }, stern: { wins: 26, losses: 4, ties: 0 }, isPlayoffTeam: true, playoffSeed: 2, playoffWins: 1, playoffLosses: 1, playoffPointsFor: 289.12, playoffPointsAgainst: 301.45 },
					{ rank: 3, name: 'Syed/Terence', wins: 10, losses: 5, pointsFor: 1945.67, pointsAgainst: 1834.23, allPlay: { wins: 121, losses: 44, ties: 0 }, stern: { wins: 22, losses: 8, ties: 0 }, isPlayoffTeam: true, playoffSeed: 3, playoffWins: 0, playoffLosses: 1, playoffPointsFor: 142.34, playoffPointsAgainst: 156.78 },
					{ rank: 4, name: 'Schex', wins: 10, losses: 5, pointsFor: 1923.45, pointsAgainst: 1867.89, allPlay: { wins: 118, losses: 47, ties: 0 }, stern: { wins: 21, losses: 9, ties: 0 }, isPlayoffTeam: true, playoffSeed: 4, playoffWins: 0, playoffLosses: 1, playoffPointsFor: 138.90, playoffPointsAgainst: 167.23 },
					{ rank: 5, name: 'Mitch/Karsten', wins: 8, losses: 7, pointsFor: 1834.12, pointsAgainst: 1856.34 },
					{ rank: 6, name: 'Jeff', wins: 7, losses: 8, pointsFor: 1789.45, pointsAgainst: 1823.67, allPlay: { wins: 98, losses: 67, ties: 0 } }
				]
			div.preview-row
				span.variant-label D1. Widget
			p.small.text-muted.mb-2 Compact view for homepage cards. Shows rank, name, record, PF, PA.
			div(style="max-width: 350px;")
				+standingsTable(sampleTeams, { variant: 'widget' })
			
			div.preview-row.mt-4
				span.variant-label D2. With Medals
			p.small.text-muted.mb-2 Final standings with gold/silver/bronze highlighting.
			div(style="max-width: 350px;")
				+standingsTable(sampleTeams, { variant: 'widget', isFinal: true, showMedals: true })
			
			div.preview-row.mt-4
				span.variant-label D3. Sidebar
			p.small.text-muted.mb-2 Medium view with all-play column. Used on schedule page.
			div(style="max-width: 450px;")
				+standingsTable(sampleTeams.slice(0, 4), { variant: 'sidebar', showCutoff: false })
			
			div.preview-row.mt-4
				span.variant-label D4. Full
			p.small.text-muted.mb-2 All columns with playoff stats. Container queries hide columns as width shrinks.
			div(style="max-width: 850px;")
				+standingsTable(sampleTeams.slice(0, 4), { variant: 'full', isFinal: true, showPlayoffStats: true })
			
			div.preview-row.mt-4
				span.variant-label D5. Mini
			p.small.text-muted.mb-2 Minimal view for division breakdowns. No header row.
			div(style="max-width: 250px;")
				+standingsTable(sampleTeams.slice(0, 3), { variant: 'mini' })
			
			div.preview-row.mt-4
				span.variant-label D6. Container Queries
