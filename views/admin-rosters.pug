extends layout.pug
include mixins

block title
	+title('Roster Management', 'Admin')

block styles
	link(rel='stylesheet' href='/css/positions.css')
	link(rel='stylesheet' href='/css/admin-rosters.css')

block content
	div.container.py-4
		div.page-header
			h1 Roster Management

		if cutResult
			if cutResult.batch
				if cutResult.failCount === 0
					div.alert.alert-success.alert-dismissible
						button.close(type='button' data-dismiss='alert') &times;
						strong Cut day complete!
						|  #{cutResult.successCount} player#{cutResult.successCount !== 1 ? 's' : ''} released.
				else
					div.alert.alert-warning.alert-dismissible
						button.close(type='button' data-dismiss='alert') &times;
						strong Cut day processed with errors.
						|  #{cutResult.successCount} succeeded, #{cutResult.failCount} failed.
						ul.mb-0.mt-2
							each r in cutResult.results
								if !r.success
									li #{r.name}: #{r.error}
			else if cutResult.success
				div.alert.alert-success.alert-dismissible
					button.close(type='button' data-dismiss='alert') &times;
					strong Cut successful!
					|  #{cutResult.playerName} has been released.
					if cutResult.buyOuts && cutResult.buyOuts.length
						|  Buyouts: 
						each bo, i in cutResult.buyOuts
							if i > 0
								| , 
							| #{bo.season}: #{formatMoney(bo.amount)}
			else
				div.alert.alert-danger.alert-dismissible
					button.close(type='button' data-dismiss='alert') &times;
					strong Error:
					|  #{cutResult.error}

		div.admin-rosters__summary.mb-4
			div.d-flex.align-items-center.justify-content-between
				div
					strong.admin-rosters__marked-count #{markedCount}
					|  player#{markedCount !== 1 ? 's' : ''} marked for cut
				form(method='POST' action='/admin/rosters/process-cut-day' onsubmit='return confirmCutDay()')
					button.btn.btn-danger(type='submit' disabled=markedCount === 0)
						i.fa.fa-scissors.mr-2
						| Process Cut Day

		div.row
			each franchise in franchises
				div.col-md-6.col-lg-4
					div.card.mb-4
						div.card-header= franchise.displayName
						div.admin-rosters__list
							if franchise.roster.length === 0
								div.admin-rosters__empty
									span.text-muted No players on roster
							else
								each player in franchise.roster
									- var posGroup = player.positions && player.positions.length > 0 ? (player.positions.some(p => ['DL','LB','DB'].includes(p)) ? 'IDP' : player.positions[0]) : null
									div.admin-rosters__row(class=[(posGroup ? 'pos-' + posGroup : ''), player.markedForCut ? 'admin-rosters__row--marked' : ''].join(' '))
										div.admin-rosters__details
											div.admin-rosters__player
												span.admin-rosters__player-name= player.name
											div.admin-rosters__meta
												if player.salary !== null
													| #{formatMoney(player.salary)}
													if player.contract
														|  · #{player.contract}
												else
													| RFA Rights
										div.admin-rosters__actions
											if player.positions && player.positions.length
												+positionBadge(player.positions)
											if player.salary !== null
												button.admin-rosters__cut-toggle(type='button' data-player-id=player.playerId class=player.markedForCut ? 'admin-rosters__cut-toggle--active' : '' title=player.markedForCut ? 'Unmark for cut' : 'Mark for cut')
													i.fa.fa-scissors
											else
												button.admin-rosters__cut-toggle.admin-rosters__cut-toggle--drop(type='button' data-player-id=player.playerId title='Drop RFA rights')
													i.fa.fa-times

block scripts
	script.
		var markedCount = #{markedCount};

		function confirmCutDay() {
			return confirm('Process cut day? This will execute all ' + markedCount + ' marked cuts immediately. This cannot be undone.');
		}

		document.querySelectorAll('.admin-rosters__cut-toggle').forEach(function(btn) {
			btn.addEventListener('click', function() {
				var playerId = btn.dataset.playerId;
				btn.disabled = true;

				fetch('/admin/rosters/mark-for-cut', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ playerId: playerId })
				})
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (data.error) {
						alert(data.error);
						return;
					}

					var row = btn.closest('.admin-rosters__row');
					if (data.markedForCut) {
						row.classList.add('admin-rosters__row--marked');
						btn.classList.add('admin-rosters__cut-toggle--active');
						btn.title = 'Unmark for cut';
						markedCount++;
					} else {
						row.classList.remove('admin-rosters__row--marked');
						btn.classList.remove('admin-rosters__cut-toggle--active');
						btn.title = 'Mark for cut';
						markedCount--;
					}

					var countEl = document.querySelector('.admin-rosters__marked-count');
					if (countEl) countEl.textContent = markedCount;

					var processBtn = document.querySelector('.admin-rosters__summary button[type="submit"]');
					if (processBtn) processBtn.disabled = (markedCount === 0);
				})
				.catch(function() {
					alert('Something went wrong. Please try again.');
				})
				.finally(function() {
					btn.disabled = false;
				});
			});
		});
