extends layout.pug
include mixins

block title
	+title('Add New Person', 'People', 'Admin')

block styles
	link(rel='stylesheet' href='/css/league.css')

block content
	div.container.py-4
		h1.mb-4 New Person

		div.row
			div.col-lg-8
				div.card.mb-4
					div.card-header
						strong Person Details
					div.card-body
						form(method='POST' action='/admin/people/new')
							div.form-group
								label(for='name') Name
								input#name.form-control(
									type='text'
									name='name'
									placeholder='Full name (e.g., "Karsten Davis")'
									required
									autofocus
								)

							div.form-group
								label(for='email') Email
								input#email.form-control(
									type='email'
									name='email'
									placeholder='Optional'
								)

							div.form-group
								label(for='birthday') Birthday
								input#birthday.form-control(
									type='text'
									name='birthday'
									placeholder='MM-DD (e.g., 09-17 for September 17)'
									pattern='\\d{2}-\\d{2}'
								)
								small.form-text.text-muted Format: MM-DD (month-day)

							div.form-group
								label(for='sleeperUserId') Sleeper User ID
								input#sleeperUserId.form-control(
									type='text'
									name='sleeperUserId'
									placeholder='Optional'
								)

							div.d-flex.justify-content-between
								button.btn.btn-primary(type='submit') Create Person
								a.btn.btn-secondary(href='/admin/people') Cancel
