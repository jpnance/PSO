extends layout
include mixins

block title
	if singleTrade
		+title('Trade #' + tradeNumber, 'Trade History')
	else
		+title('Trade History')

block og_meta
	if singleTrade && trades.length > 0
		- var trade = trades[0]
		- var ogTitle = 'Trade #' + tradeNumber + ': ' + tradeOgTitle(trade.parties, { status: 'executed', auctionSeason: trade.auctionSeason, tradeYear: trade.tradeYear })
		meta(property='og:title' content=ogTitle)
		meta(property='og:description' content=tradeOgPlainEnglish(trade.parties, { auctionSeason: trade.auctionSeason, tradeYear: trade.tradeYear, status: 'executed' }))
		meta(property='og:image' content='https://thedynastyleague.com/images/og/handshake.jpg')
		meta(property='og:url' content='https://thedynastyleague.com/trades/' + tradeNumber)
	else
		meta(property='og:title' content='Trade History')
		meta(property='og:description' content='Extra since ’08')
		meta(property='og:image' content='https://thedynastyleague.com/images/og/handshake.jpg')

block styles
	link(rel='stylesheet' href='/css/positions.css')
	link(rel='stylesheet' href='/css/trade-history.css')

block content
	div.container.py-4
		if singleTrade
			div.page-header
				h1: a.trade-history__title-link(href="/trades/" + tradeNumber) Trade ##{tradeNumber}
			
			div.row
				div.col-md-7.col-xl-5
					each trade in trades
						div.trade-card.trade-card--single(id="trade-" + trade.number)
							div.trade-card__header
								div.trade-card__timestamp-stacked
									a.trade-card__date(href="/trades/" + trade.number)= formatDateLong(trade.timestamp)
									a.trade-card__time(href="/trades/" + trade.number)= formatTime(trade.timestamp)
								div.seq-nav
									if isAdmin
										a.seq-nav__arrow(href='/admin/trades/' + trade._id title='Edit trade')
											span
												i.fa.fa-pencil
									a.seq-nav__arrow(href=prevTradeId ? '/trades/' + prevTradeId : null class=(!prevTradeId ? 'seq-nav__arrow--disabled' : ''))
										span ‹
									a.seq-nav__arrow(href=nextTradeId ? '/trades/' + nextTradeId : null class=(!nextTradeId ? 'seq-nav__arrow--disabled' : ''))
										span ›
							
							each party in trade.parties
								+tradeParty(party)
							
							if trade.notes
								div.trade-notes #{trade.notes}
		else
			//- Trade list view with pill filters
			- function toggle(id, ids) { return ids.includes(id) ? ids.filter(x => x !== id) : ids.concat(id); }
			- function toggleNum(n, arr) { return arr.includes(n) ? arr.filter(x => x !== n) : arr.concat(n); }
			//- Build query string preserving all selections
			- function buildQuery(people, regimes, franchises, assets, rounds, positions, seasons, showPastPeople, showPastRegimes) { var parts = []; if (people.length) parts.push('people=' + people.join(',')); if (regimes.length) parts.push('regimes=' + regimes.join(',')); if (franchises.length) parts.push('franchises=' + franchises.join(',')); if (assets.length) parts.push('assets=' + assets.join(',')); if (rounds.length) parts.push('rounds=' + rounds.join(',')); if (positions.length) parts.push('positions=' + positions.join(',')); if (seasons.length) parts.push('seasons=' + seasons.join(',')); if (showPastPeople) parts.push('showPastPeople=1'); if (showPastRegimes) parts.push('showPastRegimes=1'); return parts.length ? '?' + parts.join('&') : ''; }
			- var hasAnyFilter = filterPeople.length > 0 || filterRegimes.length > 0 || filterFranchises.length > 0 || filterAssetTypes.length > 0 || filterPickRounds.length > 0 || filterPositions.length > 0 || filterSeasons.length > 0
			- var baseQuery = buildQuery(filterPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, filterSeasons, showPastPeople, showPastRegimes)
				
			div.page-header
				h1 Trade History
			
			div.row
					//- SIDEBAR (appears second in DOM, but first visually on lg+)
					div#filter-sidebar.col-lg-4.order-lg-2.mb-lg-0
						//- Mobile: collapsible toggle
						- var activeFilterCount = filterPeople.length + filterRegimes.length + filterFranchises.length + filterAssetTypes.length + filterPickRounds.length + filterPositions.length + filterSeasons.length
						div.d-lg-none.mb-3
							button.btn.btn-outline-secondary.btn-sm.w-100(type="button" data-toggle="collapse" data-target="#pills-filters")
								i.fa.fa-filter.mr-1
								if hasAnyFilter
									| Filters (#{activeFilterCount} active)
								else
									| Filters
						
						//- Filters container (collapsible on mobile, always visible on lg+)
						div#pills-filters.collapse.d-lg-block
							div.trade-filter.trade-filter--sticky
								//- FRANCHISES (most familiar, top)
								div.trade-filter__section
									div.trade-filter__title Franchises
									div.trade-list__pills
										each franchise in franchises
											- var fId = franchise._id.toString()
											- var isActive = filterFranchises.includes(fId)
											- var newFranchises = toggle(fId, filterFranchises)
											- var franchiseLabel = franchise.rosterId + ' · ' + franchise.displayName
											- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
											a(class=pillClass href="/trades" + buildQuery(filterPeople, filterRegimes, newFranchises, filterAssetTypes, filterPickRounds, filterPositions, filterSeasons, showPastPeople, showPastRegimes))= franchiseLabel
								
								//- REGIMES
								div.trade-filter__section
									div.trade-filter__title Regimes
									div.trade-list__pills
										each regime in currentRegimes
											- var rId = regime._id.toString()
											- var isActive = filterRegimes.includes(rId)
											- var newRegimes = toggle(rId, filterRegimes)
											- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
											a(class=pillClass href="/trades" + buildQuery(filterPeople, newRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, filterSeasons, showPastPeople, showPastRegimes))= regime.displayName
										if pastRegimes.length > 0 && !showPastRegimes
											a.trade-pill.trade-pill--toggle(href="/trades" + buildQuery(filterPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, filterSeasons, showPastPeople, true)) More…
									if pastRegimes.length > 0 && showPastRegimes
										hr.trade-list__divider
										div.trade-list__pills
											each regime in pastRegimes
												- var rId = regime._id.toString()
												- var isActive = filterRegimes.includes(rId)
												- var newRegimes = toggle(rId, filterRegimes)
												- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
												a(class=pillClass href="/trades" + buildQuery(filterPeople, newRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, filterSeasons, showPastPeople, showPastRegimes))= regime.displayName
											a.trade-pill.trade-pill--toggle(href="/trades" + buildQuery(filterPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, filterSeasons, showPastPeople, false)) Less
								
								//- PEOPLE
								div.trade-filter__section
									div.trade-filter__title People
									div.trade-list__pills
										each person in currentPeople
											- var pId = person._id.toString()
											- var isActive = filterPeople.includes(pId)
											- var newPeople = toggle(pId, filterPeople)
											- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
											a(class=pillClass href="/trades" + buildQuery(newPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, filterSeasons, showPastPeople, showPastRegimes))= person.name
										if pastPeople.length > 0 && !showPastPeople
											a.trade-pill.trade-pill--toggle(href="/trades" + buildQuery(filterPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, true, showPastRegimes)) More…
									if pastPeople.length > 0 && showPastPeople
										hr.trade-list__divider
										div.trade-list__pills
											each person in pastPeople
												- var pId = person._id.toString()
												- var isActive = filterPeople.includes(pId)
												- var newPeople = toggle(pId, filterPeople)
												- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
												a(class=pillClass href="/trades" + buildQuery(newPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, filterSeasons, showPastPeople, showPastRegimes))= person.name
											a.trade-pill.trade-pill--toggle(href="/trades" + buildQuery(filterPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, false, showPastRegimes)) Less
								
								//- ASSET TYPES (only specialized types - players/cash are too common to filter)
								- var assetTypes = [{id: 'rfa', label: 'RFA Rights'}, {id: 'pick', label: 'Picks'}]
								div.trade-filter__section
									div.trade-filter__title Asset Types
									div.trade-list__pills
										each asset in assetTypes
											- var isActive = filterAssetTypes.includes(asset.id)
											- var newAssets = toggle(asset.id, filterAssetTypes)
											- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
											a(class=pillClass href="/trades" + buildQuery(filterPeople, filterRegimes, filterFranchises, newAssets, filterPickRounds, filterPositions, filterSeasons, showPastPeople, showPastRegimes))= asset.label
								
								//- PICK ROUNDS
								- var pickRounds = [{round: 1, label: '1st'}, {round: 2, label: '2nd'}, {round: 3, label: '3rd'}, {round: 4, label: '4th'}, {round: 5, label: '5th'}, {round: 6, label: '6th'}, {round: 7, label: '7th'}, {round: 8, label: '8th'}, {round: 9, label: '9th'}, {round: 10, label: '10th'}]
								div.trade-filter__section
									div.trade-filter__title Pick Rounds
									div.trade-list__pills
										each pr in pickRounds
											- var isActive = filterPickRounds.includes(pr.round)
											- var newRounds = toggleNum(pr.round, filterPickRounds)
											- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
											a(class=pillClass href="/trades" + buildQuery(filterPeople, filterRegimes, filterFranchises, filterAssetTypes, newRounds, filterPositions, filterSeasons, showPastPeople, showPastRegimes))= pr.label
								
								//- POSITIONS
								- var positions = ['QB', 'RB', 'WR', 'TE', 'DL', 'LB', 'DB', 'K']
								div.trade-filter__section
									div.trade-filter__title Positions
									div.trade-list__pills
										each pos in positions
											- var isActive = filterPositions.includes(pos)
											- var newPositions = toggle(pos, filterPositions)
											- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
											a(class=pillClass href="/trades" + buildQuery(filterPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, newPositions, filterSeasons, showPastPeople, showPastRegimes))= pos
								
								//- SEASONS
								div.trade-filter__section
									div.trade-filter__title Seasons
									div.trade-list__pills
										each season in availableSeasons
											- var isActive = filterSeasons.includes(season)
											- var newSeasons = toggleNum(season, filterSeasons)
											- var pillClass = isActive ? 'trade-pill trade-pill--active' : 'trade-pill'
											a(class=pillClass href="/trades" + buildQuery(filterPeople, filterRegimes, filterFranchises, filterAssetTypes, filterPickRounds, filterPositions, newSeasons, showPastPeople, showPastRegimes))= season
								
								//- SUMMARY & CLEAR
								div.trade-filter__section
									div.text-muted #{totalFiltered} trades
									if hasAnyFilter
										a.small(href="/trades?style=pills") Clear all filters
					
					//- MAIN CONTENT (narrower trade cards)
					div.col-lg-8.col-xl-6.order-lg-1
						div#trade-list
							if trades.length === 0
								div.text-center.py-5
									i.fa.fa-exchange.fa-3x.text-muted.mb-3
									p.text-muted No trades found matching your filters.
							
							each trade in trades
								div.trade-card.trade-card--single(id="trade-" + trade.number)
									div.trade-card__trade-num
										a.trade-history__title-link(href="/trades/" + trade.number) Trade ##{trade.number}
									
									div.trade-card__timestamp.trade-card__timestamp--inline.mb-2
										a.trade-card__date(href="/trades/" + trade.number)= formatDateLong(trade.timestamp)
										a.trade-card__time(href="/trades/" + trade.number)= formatTime(trade.timestamp)
									
									each party in trade.parties
										+tradeParty(party)
									
									if trade.notes
										div.trade-notes #{trade.notes}
						
						//- Bottom pagination
						- var pageSep = baseQuery ? '&' : '?'
						- var olderUrl = olderPage ? '/trades' + baseQuery + pageSep + 'page=' + olderPage : null
						- var newerUrl = newerPage ? '/trades' + baseQuery + pageSep + 'page=' + newerPage : (!isDefaultView ? '/trades' + baseQuery : null)
						div#pagination.mt-4
							+sequentialNav({ prev: olderUrl, next: newerUrl, urlPattern: '' })

block scripts
	script(src='/js/trade-history.js')
