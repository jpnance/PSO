extends layout.pug
include mixins

block title
	+title('Admin')

block styles
	style(type='text/css').
		.admin-status-row {
			display: flex;
			flex-wrap: wrap;
			gap: 1rem 2rem;
			margin-bottom: 1.5rem;
		}
		.admin-status-row .card {
			flex: 1;
			min-width: 280px;
		}
		.admin-tools__section {
			margin-bottom: 2rem;
		}
		.admin-tools__header {
			font-size: 0.7rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--text-muted);
			padding-bottom: 0.25rem;
			border-bottom: 1px solid var(--border-light);
			margin-bottom: 0.5rem;
		}
		.admin-tools__grid {
			display: grid;
			gap: 1rem;
		}
		@media (min-width: 576px) {
			.admin-tools__grid {
				gap: 0.5rem;
			}
		}
		.admin-tools__item {
			display: grid;
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
		@media (min-width: 576px) {
			.admin-tools__item {
				grid-template-columns: 180px 1fr;
				gap: 1rem;
				align-items: baseline;
			}
		}
		.admin-tools__item a.btn {
			width: 100%;
			text-align: center;
			padding: 0.25rem 0.75rem;
			font-size: 0.9rem;
		}
		.admin-tools__desc {
			font-size: 0.85rem;
			color: var(--text-muted);
		}

block content
	div.container.py-4
		div.page-header
			h1 League Admin
		
		//- Status + Banner row
		div.admin-status-row
			div.card
				div.card-header Current Status
				div.card-body
					table.table.table-sm.mb-0
						tbody
							tr
								td Season
								td.text-right: strong= config.season
							tr
								td Phase
								td.text-right: span.badge.badge-info= phase
							tr
								td Hard Cap
								td.text-right
									if hardCapActive
										span.badge.badge-danger Active
									else
										span.badge.badge-success Soft
							tr
								td Trades
								td.text-right
									if tradesEnabled
										span.badge.badge-success Enabled
									else
										span.badge.badge-secondary Disabled
							tr
								td Free Agency
								td.text-right
									if faEnabled
										if faPlayoffOnly
											span.badge.badge-warning Playoff Teams Only
										else
											span.badge.badge-success Enabled
									else
										span.badge.badge-secondary Disabled
			
			div.card
				div.card-header Site Banner
				div.card-body
					form(method='POST' action='/admin/config')
						div.form-group
							label(for='banner') Banner Message
							input#banner.form-control(type='text' name='banner' value=config.banner placeholder='Leave empty to hide banner')
						div.form-group
							label(for='bannerStyle') Style
							select#bannerStyle.form-control(name='bannerStyle')
								option(value='info' selected=(config.bannerStyle === 'info' || !config.bannerStyle)) Info (Blue)
								option(value='warning' selected=(config.bannerStyle === 'warning')) Warning (Yellow)
								option(value='danger' selected=(config.bannerStyle === 'danger')) Danger (Red)
						button.btn.btn-primary(type='submit') Update Banner
						if config.banner
							|  
							button.btn.btn-outline-secondary(type='submit' name='clearBanner' value='1') Clear
		
		//- Advance Season (conditional)
		if phase === 'dead-period' && config.deadPeriod && new Date() >= config.deadPeriod
			div.card.mb-4.border-warning
				div.card-header.bg-warning.text-dark Season Rollover
				div.card-body
					p.text-muted.small Advance to the next season. This will create picks, process expiring contracts, and let you set draft order.
					a.btn.btn-warning(href='/admin/advance-season') Advance to #{config.season + 1}
		
		//- Tools sections
		div.card
			div.card-header Admin Tools
			div.card-body
				div.admin-tools__section
					h5.admin-tools__header Season &amp; Schedule
					div.admin-tools__grid
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/schedule') League Schedule
							div.admin-tools__desc Set key dates like cut day, draft day, trade deadline, and playoffs.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/sanity') Sanity Checks
							div.admin-tools__desc Verify roster limits, budget math, pick counts, and data integrity.
				
				div.admin-tools__section
					h5.admin-tools__header Players &amp; Rosters
					div.admin-tools__grid
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/players') Player Database
							div.admin-tools__desc Search, add, edit, or merge player records.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/rosters') Process Cuts
							div.admin-tools__desc Process cut day marks in bulk.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/contracts') Process Contracts
							div.admin-tools__desc Review and finalize pending contract year assignments.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/draft/live') Live Draft
							div.admin-tools__desc Run the rookie draft in real-time.
				
				div.admin-tools__section
					h5.admin-tools__header Trades &amp; Transactions
					div.admin-tools__grid
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/process-trade') Execute Trade
							div.admin-tools__desc Manually enter and process a trade as commissioner.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/proposals') Approve Trades
							div.admin-tools__desc Review owner-submitted trades awaiting approval.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/trades') Edit Past Trade
							div.admin-tools__desc Look up a past trade by number to correct errors.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/transactions') Transaction Log
							div.admin-tools__desc Browse all transaction records with filtering and rollback.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/sleeper-transactions') Sleeper Transactions
							div.admin-tools__desc View recent Sleeper activity and sync status by week.
				
				div.admin-tools__section.mb-0
					h5.admin-tools__header People &amp; Ownership
					div.admin-tools__grid
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/transfer-franchise') Transfer Ownership
							div.admin-tools__desc Change franchise ownership or add/remove co-owners.
						div.admin-tools__item
							a.btn.btn-outline-primary(href='/admin/people') People Database
							div.admin-tools__desc Manage owner records including birthdays for the widget.
