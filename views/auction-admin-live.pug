doctype html
html
	head
		meta(charset='utf-8')
		meta(name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no')

		link(rel='stylesheet' href='/css/bootstrap.min.css')
		link(rel="stylesheet" href='https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css')

		link(rel="stylesheet" href='/css/design-tokens.css')
		link(rel="stylesheet" href='/css/auction.css')
		link(rel="stylesheet" href='/css/positions.css')

		script(src='/js/jquery.min.js')
		script(src='/js/umd/popper.min.js')
		script(src='/js/bootstrap.min.js')
		script
			| $(function() { $('[data-toggle="tooltip"]').tooltip(); });

		script.
			const referenceSite = !{JSON.stringify(referenceSite)};
			const owners = !{JSON.stringify(owners)};
			const webSocketUrl = !{JSON.stringify(webSocketUrl)};
			const AUCTION_SEARCH_URL = '/auction/admin/search';
			const AUCTION_RECORD_URL = '/auction/admin/record';
			const AUCTION_PREVIEW_REMOVE_URL = '/auction/admin/preview-remove';

		script(src='/js/auction.js')

		title Bid Buddy Admin

	body.admin
		dialog#reconnect-dialog.auction-dialog
			p.reconnect-dialog__message Connection lost.
			div.reconnect-dialog__actions
				button#reconnect.btn.btn-primary Reconnect

		dialog#record-result-dialog.auction-dialog
			button#record-close.auction-dialog__close(type='button' aria-label='Close') &times;
			input#record-player-id(type='hidden')
			input#record-player-name-hidden(type='hidden')
			input#record-type(type='hidden')
			input#record-rfa-holder(type='hidden')
			input#record-high-bidder(type='hidden')
			input#record-initial-amount(type='hidden')

			div#record-screen-final-bid.record-result__screen
				div.record-result__hero
					div.record-result__hero-name#final-bid-player
					div.record-result__hero-sub
						span#final-bid-situation-label
				div.record-result__bid-row
					div.record-result__bid-field
						div.input-group
							div.input-group-prepend
								span.input-group-text $
							input#final-bid-raise-amount.form-control(type='number' min='1')
					div.record-result__bid-from
						| from
						|
						strong
							span#final-bid-owner
				div#final-bid-error.record-result__error
				input#final-bid-amount(type='hidden')
				div.record-result__actions
					button#final-bid-back.btn.btn-secondary Back
					button#final-bid-continue.btn.btn-primary Continue

			div#record-screen-rfa-decision.record-result__screen
				div.record-result__hero
					div.record-result__hero-name#rfa-decision-player
					div.record-result__hero-sub
						| $
						span#rfa-decision-amount
						|  from
						|
						span#rfa-decision-bidder
				p.record-result__question
					| Does
					|
					strong#rfa-decision-holder
					|
					| match?
				div.record-result__actions
					button#rfa-decision-back.btn.btn-secondary Back
					div.record-result__actions-right
						button#rfa-pass.btn.btn-danger Pass
						button#rfa-match.btn.btn-success Match

			div#record-screen-review.record-result__screen
				div#review-body.record-result__review
				div.record-result__actions
					button#review-back.btn.btn-secondary Back
					button#review-record.btn.btn-success Record
				div#record-status

			div#record-screen-edit.record-result__screen
				div.record-result__hero
					div.record-result__hero-name#edit-player-name
				div.record-result__field
					label.record-result__label Situation
					select#edit-situation.form-control
						option(value='UFA') UFA
						each owner in owners
							option(value='RFA-' + owner) RFA (#{owner})
				div.record-result__field
					label.record-result__label High Bidder
					select#edit-winner.form-control
						each owner in owners
							option(value=owner) #{owner}
				div.record-result__field
					label.record-result__label Winning Bid
					div.input-group
						div.input-group-prepend
							span.input-group-text $
						input#edit-amount.form-control(type='number' min='1')
				div.record-result__actions
					button#edit-cancel.btn.btn-secondary Cancel
					button#edit-continue.btn.btn-primary Continue

		dialog#remove-owner-dialog.auction-dialog
			button#remove-owner-close.auction-dialog__close(type='button' aria-label='Close') &times;
			div.record-result__hero
				div.record-result__hero-name#remove-owner-name
			p.remove-owner__prompt
				| This will forfeit all RFA rights held by this owner.
			ul#remove-owner-players.remove-owner__player-list
			div#remove-owner-no-rfa.remove-owner__no-rfa
				| No RFA rights to forfeit.
			div.record-result__actions
				button#remove-owner-cancel.btn.btn-secondary Cancel
				button#remove-owner-confirm.btn.btn-danger Remove

		div.container
			hr

			div#controls.row.justify-content-center
				div.col-12.col-lg-6.text-center
					button#pause.btn.btn-warning.m-1
						i.fa.fa-pause
						|
						| Pause
					button#activate.btn.btn-success.m-1
						i.fa.fa-play
						|
						| Activate
					button#pop.btn.btn-danger.m-1
						i.fa.fa-eraser
						|
						| Pop Top Bid
					div.mt-2
						a.auction-admin__debug-toggle(href='#' data-toggle='collapse' data-target='#debug-controls')
							i.fa.fa-wrench
							|
							|  Debug
						div#debug-controls.collapse
							div.mt-1
								button#simulate-bids.btn.btn-outline-info.btn-sm.m-1
									i.fa.fa-random
									|
									| Simulate Bids
								button#start-demo.btn.btn-outline-primary.btn-sm.m-1 Start Demo
								button#stop-demo.btn.btn-outline-primary.btn-sm.m-1 Stop Demo

			hr

			form#set-timer-form
				div.form-row.justify-content-center.m-1
					div.input-group.col-6.col-lg-3
						div.input-group-prepend
							span.input-group-text Guaranteed
						input#set-timer-guaranteed.form-control(type='number' value='30')

				div.form-row.justify-content-center.m-1
					div.input-group.col-6.col-lg-3
						div.input-group-prepend
							span.input-group-text Reset To
						input#set-timer-reset-to.form-control(type='number' value='10')

				div.form-row.justify-content-center.m-1
					div.col-6.text-center
						button#set-timer.btn.btn-primary
							i.fa.fa-clock-o
							|
							| Set Timer

			hr

			div.row.justify-content-center
				div.col-12.col-md-6
					div.row
						div.nominating.next.col-6.text-center
							span.when Up Next
							br
							span.who --

						div.nominating.later.col-6.text-center
							span.when After That
							br
							span.who --

			hr

			form#nomination-form
				div.form-row.justify-content-center.m-1
					div.input-group.col-12.col-lg-6.text-center
						select#nominator.form-control(required)
							option(value='') --
							each owner in owners
								option(value=owner) #{owner}

				div.form-row.justify-content-center.m-1
					div.col-12.col-lg-6
						div.auction-search
							input#player-search.form-control(type='text' placeholder='Search for a player...' autocomplete='off')
							div#player-search-results.auction-search__results

				input#player-id(type='hidden' name='playerId' value='')
				input#team(type='hidden' name='team' value='')
				input#pfr-id(type='hidden' name='pfrId' value='')

				br

				div.form-row.justify-content-center.m-1
					div.col-12.col-lg-6.text-center
						input#name.form-control(type='text' name='name' placeholder='Name' required)

				div.form-row.justify-content-center.m-1
					div.col-12.col-lg-6.text-center
						div.row
							div.col-6
								input#position.form-control(type='text' name='position' placeholder='Position')
							div.col-6
								select#situation.form-control(name='situation' required)
									option(value='') --
									each situation in situations
										option(value=situation) #{situation}

				div.form-row.justify-content-center.m-1
					div.col-6.text-center
						input.btn.btn-primary(type='submit' value='Nominate')

			hr

			form#bid-form
				input#force-bid(type='hidden' name='force-bid' value='true')

				div.form-row.justify-content-center.m-1
					div.input-group.col-6.col-lg-3
						div.input-group-prepend
							span.input-group-text $
						input#bid-amount.form-control(type='number')
					div.col-6.col-lg-3
						select#owner.form-control(name='owner')
							each owner in owners
								option(value=owner) #{owner}
				div.form-row.justify-content-center.m-1
					div.col-6.text-center
						input.btn.btn-primary(type='submit' value='Force Bid')

			hr

			div.row.justify-content-center
				div.col-12.col-lg-6.text-center
					div#player
						h5#nominator
							span#nominator-name
							|
							|
							span#nominator-text
						h1#player-name
							a(target='_blank')
						h4
							span#player-position
							| ,
							|
							span#player-situation

			div.row.justify-content-center
				div.col-12.col-lg-6.text-center
					ul#bid-history

			hr

			form#nomination-order-form
				div.form-row.justify-content-center.m-1
					div.input-group.col-12.col-lg-6.text-center
						select#remove-owner.form-control
							option(value='') --
							each owner in owners
								option(value=owner) #{owner}
				div.form-row.justify-content-center.m-1
					div.col-6.text-center
						input.btn.btn-danger(type='submit' value='Remove Owner')

			hr

			div#more-controls.row.justify-content-center
				div.col-12.col-lg-6.text-center
					button#call-roll.btn.btn-info.m-1
						i.fa.fa-refresh
						|
						| Call Roll

			hr

			div.row.justify-content-center
				div.col-12.col-lg-6.text-center
					ul#attendance

			hr
