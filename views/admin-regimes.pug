extends layout.pug
include mixins

block title
	+title('Regimes', 'Admin')

block styles
	link(rel='stylesheet' href='/css/league.css')

block content
	div.container.py-4
		div.page-header
			h1 Regimes

		p.text-muted.mb-4 Manage franchise ownership groups. A regime represents an ownership configuration — one or more people controlling a franchise during a span of seasons.

		- var activeRegimes = regimes.filter(function(r) { return r.isActive; })
		- var inactiveRegimes = regimes.filter(function(r) { return !r.isActive; })

		if activeRegimes.length
			h5.mb-3 Active Regimes
			table.data-table.mb-4
				thead
					tr
						th Name
						th Owners
						th(style='width: 1px')
				tbody
					each regime in activeRegimes
						tr
							td
								a(href='/admin/regimes/' + regime._id)= regime.displayName
							td
								if regime.ownerNames.length
									= regime.ownerNames.join(', ')
								else
									span.text-muted No owners assigned
							td
								a.btn.btn-sm.btn-outline-primary(href='/admin/regimes/' + regime._id) Edit

		if inactiveRegimes.length
			h5.mb-3.mt-4 Past Regimes
			table.data-table
				thead
					tr
						th Name
						th Owners
						th Tenures
						th(style='width: 1px')
				tbody
					each regime in inactiveRegimes
						tr
							td
								a(href='/admin/regimes/' + regime._id)= regime.displayName
							td
								if regime.ownerNames.length
									= regime.ownerNames.join(', ')
								else
									span.text-muted —
							td= regime.tenureCount
							td
								a.btn.btn-sm.btn-outline-secondary(href='/admin/regimes/' + regime._id) Edit
