extends layout.pug
include mixins

block title
	+title('Sleeper Transactions', 'Admin')

block styles
	style.
		.sleeper-txn {
			border: 1px solid var(--border-light);
			border-radius: 4px;
			padding: 0.75rem;
			margin-bottom: 0.75rem;
			background: #fff;
		}
		.sleeper-txn--processed {
			border-left: 3px solid var(--color-success);
		}
		.sleeper-txn__header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0.5rem;
		}
		.sleeper-txn__type {
			font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.8rem;
			padding: 0.2rem 0.5rem;
			border-radius: 3px;
		}
		.sleeper-txn__type--waiver {
			background: #e3f2fd;
			color: #1565c0;
		}
		.sleeper-txn__type--free_agent {
			background: #fff3e0;
			color: #e65100;
		}
		.sleeper-txn__type--trade {
			background: #f3e5f5;
			color: #7b1fa2;
		}
		.sleeper-txn__type--commissioner {
			background: #fce4ec;
			color: #c2185b;
		}
		.sleeper-txn__time {
			font-size: 0.8rem;
			color: var(--text-muted);
		}
		.sleeper-txn__id {
			font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.7rem;
			color: var(--text-tertiary);
		}
		.sleeper-txn__body {
			font-size: 0.9rem;
		}
		.sleeper-txn__moves {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}
		.sleeper-txn__move {
			display: inline-flex;
			align-items: center;
			gap: 0.25rem;
			padding: 0.2rem 0.5rem;
			border-radius: 3px;
			font-size: 0.85rem;
		}
		.sleeper-txn__move--add {
			background: #e8f5e9;
			color: #2e7d32;
		}
		.sleeper-txn__move--drop {
			background: #ffebee;
			color: #c62828;
		}
		.sleeper-txn__faab {
			font-size: 0.85rem;
			color: var(--text-secondary);
			margin-top: 0.25rem;
		}
		.sleeper-txn__status {
			font-size: 0.75rem;
			margin-top: 0.5rem;
		}
		.sleeper-txn__status--processed {
			color: var(--color-success);
		}
		.sleeper-txn__status--pending {
			color: var(--text-muted);
		}

block content
	div.container.py-4
		div.page-header
			h1 Sleeper Transactions

		div.page-nav.mb-4
			+sequentialNav({ items: availableSeasons, current: season, urlPattern: '/admin/sleeper-transactions?season=', urlSuffix: '&week=' + week, reverseDropdown: true })
			+sequentialNav({ items: weeks, current: week, urlPattern: '/admin/sleeper-transactions?season=' + season + '&week=', labelFn: function(w) { return 'Week ' + w } })

		if error
			div.alert.alert-danger= error

		if transactions.length === 0 && !error
			div.alert.alert-info No transactions found for week #{week}.
		else
			div.mb-3
				span.badge.badge-secondary #{transactions.length} transaction#{transactions.length === 1 ? '' : 's'}

			each txn in transactions
				- var isProcessed = processedMap[txn.transaction_id]
				div.sleeper-txn(class=isProcessed ? 'sleeper-txn--processed' : '')
					div.sleeper-txn__header
						div
							span.sleeper-txn__type(class='sleeper-txn__type--' + txn.type)= txn.type
							span.sleeper-txn__id.ml-2= txn.transaction_id
						div.sleeper-txn__time
							- var date = new Date(txn.created)
							= date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })
							|  
							= date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })
					
					div.sleeper-txn__body
						div.sleeper-txn__moves
							//- Adds
							if txn.adds
								each rosterId, sleeperId in txn.adds
									- var player = playerBySleeperId[sleeperId]
									- var franchise = franchiseByRosterId[rosterId]
									span.sleeper-txn__move.sleeper-txn__move--add
										i.fa.fa-plus-circle
										if player
											= player.name
										else
											| Player #{sleeperId}
										| → 
										if franchise
											= franchise.displayName
										else
											| Roster #{rosterId}
							
							//- Drops
							if txn.drops
								each rosterId, sleeperId in txn.drops
									- var player = playerBySleeperId[sleeperId]
									- var franchise = franchiseByRosterId[rosterId]
									span.sleeper-txn__move.sleeper-txn__move--drop
										i.fa.fa-minus-circle
										if player
											= player.name
										else
											| Player #{sleeperId}
										|  ← 
										if franchise
											= franchise.displayName
										else
											| Roster #{rosterId}
						
						//- FAAB info
						if txn.type === 'waiver' && txn.settings && txn.settings.waiver_bid !== undefined
							div.sleeper-txn__faab
								| FAAB bid: $#{txn.settings.waiver_bid}
						
						//- Processing status
						div.sleeper-txn__status(class=isProcessed ? 'sleeper-txn__status--processed' : 'sleeper-txn__status--pending')
							if isProcessed
								i.fa.fa-check-circle.mr-1
								| Processed
								a.ml-2(href='/admin/transactions') View in log
							else
								i.fa.fa-clock.mr-1
								| Not yet processed
