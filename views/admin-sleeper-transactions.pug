extends layout.pug
include mixins

block title
	+title('Sleeper Transactions', 'Admin')

block styles
	link(rel='stylesheet' href='/css/admin-sleeper-transactions.css')

block content
	div.container.py-4
		div.page-header
			h1 Sleeper Transactions

		div.page-nav.mb-4
			+sequentialNav({ items: availableSeasons, current: season, urlPattern: '/admin/sleeper-transactions?season=', urlSuffix: '&week=' + week, reverseDropdown: true })
			+sequentialNav({ items: weeks, current: week, urlPattern: '/admin/sleeper-transactions?season=' + season + '&week=', labelFn: function(w) { return 'Week ' + w } })

		if ruleResult === 'success'
			+alertBanner('success', 'fa-check', ruleMessage || 'Ruling saved.').mb-4
		if ruleResult === 'error'
			+alertBanner('danger', 'fa-times-circle', 'Ruling failed: ' + (ruleMessage || 'Unknown error')).mb-4

		if error
			div.alert.alert-danger= error

		if transactions.length === 0 && !error
			div.alert.alert-info No transactions found for week #{week}.
		else
			div.mb-3
				span.badge.badge-secondary #{transactions.length} transaction#{transactions.length === 1 ? '' : 's'}

			each txn in transactions
				- var isProcessed = processedMap[txn.transaction_id]
				- var review = reviewMap[txn.transaction_id]
				- var isBlocked = review && review.status === 'blocked'
				- var isRuled = review && review.status !== 'blocked'
				- var isClaim = (txn.type === 'waiver' || txn.type === 'free_agent') && txn.status === 'complete'
				- var canRule = isClaim && !isProcessed && !isRuled && season === currentSeason
				- var cardClass = isProcessed ? 'sleeper-txn--processed' : isBlocked ? 'sleeper-txn--blocked' : isRuled ? 'sleeper-txn--ruled' : txn.status === 'failed' ? 'sleeper-txn--failed' : ''
				div.sleeper-txn(id='txn-' + txn.transaction_id class=cardClass)
					div.sleeper-txn__header
						div
							span.sleeper-txn__type(class='sleeper-txn__type--' + txn.type)= txn.type
							if txn.status !== 'complete'
								span.sleeper-txn__sleeper-status.ml-2= txn.status
							span.sleeper-txn__id.ml-2= txn.transaction_id
						div.sleeper-txn__time
							- var date = new Date(txn.created)
							= date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })
							|  
							= date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })
					
					div.sleeper-txn__body
						div.sleeper-txn__moves
							//- Adds
							if txn.adds
								each rosterId, sleeperId in txn.adds
									- var player = playerBySleeperId[sleeperId]
									- var franchise = franchiseByRosterId[rosterId]
									span.sleeper-txn__move.sleeper-txn__move--add
										i.fa.fa-plus-circle
										if player
											= player.name
										else
											| Player #{sleeperId}
										| → 
										if franchise
											= franchise.displayName
										else
											| Roster #{rosterId}
							
							//- Drops
							if txn.drops
								each rosterId, sleeperId in txn.drops
									- var player = playerBySleeperId[sleeperId]
									- var franchise = franchiseByRosterId[rosterId]
									span.sleeper-txn__move.sleeper-txn__move--drop
										i.fa.fa-minus-circle
										if player
											= player.name
										else
											| Player #{sleeperId}
										|  ← 
										if franchise
											= franchise.displayName
										else
											| Roster #{rosterId}
						
						//- FAAB info
						if txn.type === 'waiver' && txn.settings && txn.settings.waiver_bid !== undefined
							div.sleeper-txn__faab
								| FAAB bid: #{formatMoney(txn.settings.waiver_bid)}
						
						//- Processing status
						if isProcessed
							div.sleeper-txn__status.sleeper-txn__status--processed
								i.fa.fa-check-circle.mr-1
								| Processed
								a.ml-2(href='/admin/transactions') View in log
						else if isBlocked
							div.sleeper-txn__status.sleeper-txn__status--blocked
								i.fa.fa-ban.mr-1
								| Blocked — holding up all Sleeper imports
							div.sleeper-txn__notes= review.problems.join('; ')
						else if isRuled
							div.sleeper-txn__status.sleeper-txn__status--ruled
								i.fa.fa-gavel.mr-1
								if review.status === 'ignored'
									| Ruled: ignored
								else
									| Ruled: replaced
									a.ml-2(href='/admin/transactions') View in log
							if review.notes
								div.sleeper-txn__notes= review.notes
						else if isClaim
							div.sleeper-txn__status.sleeper-txn__status--pending
								i.fa.fa-clock.mr-1
								| Not yet processed

						if canRule
							div.sleeper-txn__actions
								form.sleeper-txn__ignore-form(method='POST' action='/admin/sleeper-transactions/' + txn.transaction_id + '/ignore' onsubmit='return confirm("Ignore this claim as if it never happened? You will still need to undo the roster move in Sleeper.")')
									input(type='hidden' name='season' value=season)
									input(type='hidden' name='week' value=week)
									input.form-control.form-control-sm(type='text' name='notes' placeholder='Reason (optional)')
									button.btn.btn-outline-secondary.btn-sm(type='submit') Ignore
								a.btn.btn-outline-primary.btn-sm(href='/admin/sleeper-transactions/' + txn.transaction_id + '/replace?season=' + season + '&week=' + week) Replace…
